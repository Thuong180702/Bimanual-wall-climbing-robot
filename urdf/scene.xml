    </default>
    <default class="col">
      <geom group="3" rgba="0.5 0.6 0.9 0.35" friction="1.0 0.02 0.001"/>
    </default>
    <default class="hold">
      <geom type="cylinder" material="rung" friction="1.2 0.02 0.001"/>
