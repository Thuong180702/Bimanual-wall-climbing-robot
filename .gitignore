# virtualenv -- 789 MB, rebuild with: pip install -r requirements.txt
.venv/

# training runs, checkpoints, rendered videos and stills -- all reproducible
out/
# a run packed on a box (rl/gpu_run.sh), carried in the repo root: never an object. Untracked,
# gpu14.tgz was hashed by something on its next box, again and again, and each copy cut off
# halfway left a 135 MB tmp_obj in .git/objects -- 168 of them filled the 32 GB disk (2026-10-24)
*.tgz

# generated from scene.xml by `python -m rl.lessons`, so it would only go stale here
urdf/lessons/

__pycache__/
*.pyc
.DS_Store

# vendor actuator CAD -- the manufacturers', not ours. Fetch and checksum with:
#   python cad/tools/fetch_vendor.py
cad/vendor/

# generated CAD outputs and visual meshes -- rebuilt by:
#   python cad/tools/gen_urdf.py && python urdf/_gen_scene.py
cad/STEP/
cad/tmp/

# the Mid-360 scan pattern (rl/slam_test.py fetches it), not ours to redistribute
slam/vendor/
